VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_STORAGE_BUCKET=your_storage_bucket_name

# Analytics/monitoring -- optional, both no-op cleanly if unset
VITE_POSTHOG_KEY=your_posthog_key
VITE_POSTHOG_HOST=https://eu.i.posthog.com
VITE_SENTRY_DSN=your_sentry_dsn

# OAuth (Google, Facebook, Apple) is configured entirely in the Supabase
# dashboard under Auth Providers -- no local env vars needed for it.
